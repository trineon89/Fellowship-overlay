<Window x:Class="Fellowship_overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay"
        Width="420"
        Height="280"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border Background="#CC000000" CornerRadius="12" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock x:Name="TitleTextBlock"
                           Text="Overlay"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           DockPanel.Dock="Left" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="BuffPanel" />
            </ScrollViewer>

            <Border x:Name="StatusOverlay"
                    Background="#CC1F1F1F"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Grid.RowSpan="2"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusTextBlock"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="14"
                           TextAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>