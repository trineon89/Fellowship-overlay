<Window x:Class="Fellowship_overlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Fellowship_overlay.Core"
        Title="Fellowship Overlay Settings"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Combat-log folder" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="LogDirTextBox"
                         Grid.Column="1"
                         MinWidth="260"
                         VerticalContentAlignment="Center" />
                <Button Content="Browse..."
                        Grid.Column="2"
                        Width="90"
                        Margin="12,0,0,0"
                        Click="OnBrowseLogDir" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Character name" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="PlayerNameTextBox"
                         Grid.Column="1"
                         MinWidth="200"
                         VerticalContentAlignment="Center" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Character GUID (optional)" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="PlayerGuidTextBox"
                         Grid.Column="1"
                         MinWidth="200"
                         VerticalContentAlignment="Center" />
            </Grid>
			
            <CheckBox x:Name="LockOverlaysCheckBox"
                      Content="Lock overlays in place (click-through mode)"
                      Margin="0,12,0,0"
                      Checked="OnLockOverlaysChanged"
                      Unchecked="OnLockOverlaysChanged" />

            <CheckBox x:Name="EnableDebugCheckBox"
                      Content="Enable debug window"
                      Margin="0,4,0,0"
                      Checked="OnDebugModeChanged"
                      Unchecked="OnDebugModeChanged" />
					  
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#33222222" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
               <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Overlays" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="OverlayHintText"
                                   Text="Add overlays to track different buff sets."
                                   Foreground="Gray"
                                   Margin="0,4,0,12" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,0,0,12"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="OverlayListBox"
                                 MinHeight="140"
                                 VerticalAlignment="Stretch"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="OnOverlaySelectionChanged" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <ComboBox x:Name="PresetComboBox"
                                  Width="150"
                                  Margin="0,0,8,0"
                                  DisplayMemberPath="Name"
                                  SelectedIndex="0" />
                        <Button Content="Add" Width="60" Click="OnAddOverlay" />
                        <Button Content="Remove" Width="70" Margin="8,0,0,0" Click="OnRemoveOverlay" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#33222222" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Overlay details" FontSize="18" FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="OverlayNameTextBox"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="7"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnOverlayNameChanged" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Left" VerticalAlignment="Center" />
                            <TextBox x:Name="OverlayLeftTextBox"
                                     Grid.Column="1"
                                     Margin="4,0"
                                     VerticalContentAlignment="Center"
                                     PreviewTextInput="OnNumericTextInput"
                                     LostFocus="OnOverlayPositionChanged" />

                            <TextBlock Grid.Column="2" Text="Top" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox x:Name="OverlayTopTextBox"
                                     Grid.Column="3"
                                     Margin="4,0"
                                     VerticalContentAlignment="Center"
                                     PreviewTextInput="OnNumericTextInput"
                                     LostFocus="OnOverlayPositionChanged" />

                            <TextBlock Grid.Column="4" Text="Width" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox x:Name="OverlayWidthTextBox"
                                     Grid.Column="5"
                                     Margin="4,0"
                                     VerticalContentAlignment="Center"
                                     PreviewTextInput="OnNumericTextInput"
                                     LostFocus="OnOverlaySizeChanged" />

                            <TextBlock Grid.Column="6" Text="Height" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox x:Name="OverlayHeightTextBox"
                                     Grid.Column="7"
                                     Margin="4,0"
                                     VerticalContentAlignment="Center"
                                     PreviewTextInput="OnNumericTextInput"
                                     LostFocus="OnOverlaySizeChanged" />
                        </Grid>
						
                        <CheckBox x:Name="ShowIconsOnlyCheckBox"
                                  Content="Show icons only"
                                  Margin="0,12,0,0"
                                  Checked="OnOverlayDisplayModeChanged"
                                  Unchecked="OnOverlayDisplayModeChanged" />
								  
								  <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Buff area"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="BuffAreaTextBlock"
                                       Grid.Column="1"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       Text="Not set" />
                            <Button Grid.Column="2"
                                    Content="Cast buff area"
                                    Padding="16,4"
                                    Click="OnCastBuffArea" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="Tracked buffs" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Pick which buffs should appear in this overlay."
                                   Foreground="Gray"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
                        <ItemsControl x:Name="BuffsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="260" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Definition.Name}"
                                              Tag="{Binding Definition.SpellId}"
                                              Margin="0,4,12,4"
                                              IsChecked="{Binding IsTracked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Checked="OnBuffSelectionChanged"
                                              Unchecked="OnBuffSelectionChanged" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       DockPanel.Dock="Left"
                       Foreground="Gray"
                       VerticalAlignment="Center" />
            <Button Content="Apply"
                    Width="120"
                    DockPanel.Dock="Right"
                    Click="OnApply" />
        </DockPanel>
    </Grid>
</Window>